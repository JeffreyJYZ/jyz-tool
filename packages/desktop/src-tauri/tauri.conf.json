{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "jyz",
	"version": "0.1.0-alpha.1",
	"identifier": "land.jyz.desktop",
	"build": {
		"frontendDist": "../ui"
	},
	"app": {
		"windows": [
			{
				"title": "jyz",
				"width": 900,
				"height": 600,
				"minWidth": 480,
				"minHeight": 320,
				"theme": "Dark"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "DeveloperTool",
		"shortDescription": "jyz desktop shell",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
